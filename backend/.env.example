# PostgreSQL
# DATABASE_URL: la usa la app. En Neon: cadena "Pooled connection" (host con -pooler).
# DIRECT_URL: la usa `prisma migrate`. En Neon: cadena directa (host sin -pooler).
# En local ambas pueden ser iguales. En Neon añade ?sslmode=require
DATABASE_URL="postgresql://zenkai:zenkai@localhost:5432/zenkai?schema=public"
DIRECT_URL="postgresql://zenkai:zenkai@localhost:5432/zenkai?schema=public"
# JWT (obligatorio en producción; genera uno con: openssl rand -base64 32)
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="12h"
# Servidor
PORT=4000
HOST=0.0.0.0
# URL exacta del frontend; varias separadas por comas. "*" solo en desarrollo
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
# false = desactiva Swagger UI en /docs
DOCS_ENABLED=true
# true detrás de un proxy (Render) para que el límite de intentos use la IP real
TRUST_PROXY=false
# Seed de demo (obligatorias en producción; en desarrollo: admin123 / mesa123)
# SEED_ADMIN_EMAIL=admin@torneo.dojo
# SEED_ADMIN_PASSWORD=
# SEED_TABLE_PASSWORD=
# SEED_ON_START=true
# Solo para `npm run seed:demo:reset` (borra todo y recarga la demo)
# ALLOW_DEMO_RESET=false
