# Variables para docker-compose (copiar a .env y ajustar)
POSTGRES_USER=zenkai
POSTGRES_PASSWORD=zenkai
POSTGRES_DB=zenkai
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=12h
# URL exacta desde la que se abre la web (en producción no se admite "*")
CORS_ORIGIN=http://localhost:8080
# true = carga datos de prueba si la base de datos está vacía
SEED_ON_START=true
# Usuarios del seed (mesa@ y mesa2@torneo.dojo usan SEED_TABLE_PASSWORD)
SEED_ADMIN_EMAIL=admin@torneo.dojo
SEED_ADMIN_PASSWORD=admin123
SEED_TABLE_PASSWORD=mesa123
# false = oculta Swagger en /docs
DOCS_ENABLED=true
WEB_PORT=8080
API_PORT=4000
